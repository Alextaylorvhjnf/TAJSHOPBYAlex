# ══════════════════════════════════════════════════════════════════════
#  TAJ Electronics — environment template
#
#  `install.sh` copies this file to `.env` (never overwriting an existing
#  one) and generates a strong random AUTH_SECRET.
#  docker-compose.yml reads `.env` automatically.
# ══════════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────────
# Session/cookie signing secret. Generate one:
#   openssl rand -hex 32
AUTH_SECRET=change-me-install-sh-replaces-this

# ── RECOMMENDED ───────────────────────────────────────────────────────
# Public base URL of the store — used by sitemap, e-mails and the
# ZarinPal payment callback. Leave the default for a plain IP install.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OPTIONAL (configure later from Admin Panel → Settings) ────────────
# Gemini API key for the AI shopping assistant (Admin → تنظیمات → AI)
GEMINI_API_KEY=

# ZarinPal merchant ID (Admin → تنظیمات → پرداخت) — backend only
ZARINPAL_MERCHANT_ID=

# ── Docker deployments: leave DATABASE_URL unset ──────────────────────
# docker-compose.yml injects DATABASE_URL=file:/app/db/custom.db
# (SQLite on the persistent taj_db volume).
#
# Only for NON-Docker runs, point it at a writable absolute path:
# DATABASE_URL=file:/home/USER/taj-electronics/db/custom.db
