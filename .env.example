# ═══ TAJ Electronics — متغیرهای محیطی (الگوی نصب) ═══
# این فایل الگو است؛ install.sh به‌صورت خودکار .env واقعی را می‌سازد
# و AUTH_SECRET تصادفی قوی در آن می‌گذارد (هرگز روی .env موجود بازنویسی نمی‌شود).

# آدرس دیتابیس SQLite — پیش‌فرض مسیر داخل کانتینر Docker (volume مانگار taj_db).
# برای اجرای لوکال بدون Docker: DATABASE_URL="file:../db/custom.db"
DATABASE_URL="file:/app/db/custom.db"

# کلید امضای نشست‌ها/رمزنگاری — در نصب واقعی حتماً جایگزین شود
# (تولید مقدار تصادفی: openssl rand -hex 32)
AUTH_SECRET=CHANGE_ME

# آدرس عمومی سایت — پس از تنظیم دامنه، مقدار واقعی را بگذارید
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (اختیاری) منبع مانیفست به‌روزرسانی — خالی = کانال رسمی گیت‌هاب (پیش‌فرض).
# فقط اگر کانال شخصی می‌خواهید فعال کنید:
# UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/Alextaylorvhjnf/TAJSHOPBYAlex/main/updates/update-manifest.json
